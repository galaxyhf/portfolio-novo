# Gere sua chave em: https://resend.com/api-keys
RESEND_API_KEY=""

# Neon Postgres: pooled para a aplicação e direct para migrações.
DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://.../neondb?sslmode=require"

# Managed Better Auth do Neon.
NEON_AUTH_BASE_URL="https://.../neondb/auth"
# Gere com: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
# Lista separada por vírgulas; somente estes usuários acessam o painel.
ADMIN_EMAILS=""

# Neon Object Storage (preenchidas por `neon env pull`).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
# Opcional: URL pública/CDN do bucket. Sem ela, endpoint + bucket são usados.
NEON_STORAGE_PUBLIC_URL=""
